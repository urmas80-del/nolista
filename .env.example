# Copy this file to .env and fill in the values from
# Supabase Dashboard -> Project Settings -> API.
#
# Both values are bundled into the app and are PUBLIC by design.
# Security comes from Row Level Security policies in the database,
# not from keeping these secret. Never put the service_role key here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
